msgid "No operations configured"
msgstr "Операции не настроены"

msgid "Configuration is in DRAFT mode (@n operation(s), validation failed)"
msgstr "Конфигурация в режиме ЧЕРНОВИКА (@n операций, проверка не пройдена)"

msgid "The saved configuration failed validation and will not run on cron. First error: @msg"
msgstr "Сохранённая конфигурация не прошла проверку и не будет выполняться по крону. Первая ошибка: @msg"

msgid "@n operation(s) configured, cron scheduling enabled"
msgstr "@n операций настроено, планирование по cron включено"

msgid "@n operation(s) configured, cron scheduling disabled"
msgstr "@n операций настроено, планирование по cron отключено"

msgid "@status at @date"
msgstr "@status — @date"

msgid "See the run log on the <a href=\":url\">SQL Aggregator settings page</a>."
msgstr "См. журнал запуска на <a href=\":url\">странице настроек SQL Агрегатора</a>."

msgid "Search API SQL Aggregator — last run"
msgstr "Search API SQL Aggregator — последний запуск"

msgid "Search API SQL Aggregator — Custom SQL"
msgstr "Search API SQL Aggregator — Custom SQL"

msgid "@n Custom SQL block(s) configured, but Custom SQL is disabled in settings.php — these blocks will fail at run time"
msgstr "@n блок(ов) Custom SQL настроено, но Custom SQL отключён в settings.php — эти блоки завершатся ошибкой при выполнении"

msgid "@n Custom SQL block(s) configured — write target checked against the Search API whitelist, reads are unrestricted"
msgstr "@n блок(ов) Custom SQL настроено — цель записи проверяется по белому списку Search API, чтение не ограничено"

msgid "@n Custom SQL block(s) configured, but this server has not activated execution (settings.php run key not set) — these blocks will not run"
msgstr "@n блок(ов) Custom SQL настроено, но этот сервер не активировал выполнение (ключ выполнения settings.php не задан) — эти блоки не будут выполняться"

msgid "Search API SQL Aggregator — Unsafe Custom SQL"
msgstr "Search API SQL Aggregator — Unsafe Custom SQL"

msgid "@n Unsafe Custom SQL block(s) configured AND ACTIVE on this server — no table/command restriction at all"
msgstr "@n блок(ов) Unsafe Custom SQL настроено И АКТИВНО на этом сервере — вообще без ограничений на таблицы/команды"

msgid "@n Unsafe Custom SQL block(s) configured, but this server has not activated execution (settings.php run key not set) — these blocks will not run"
msgstr "@n блок(ов) Unsafe Custom SQL настроено, но этот сервер не активировал выполнение (ключ выполнения settings.php не задан) — эти блоки не будут выполняться"

msgid "@n Unsafe Custom SQL block(s) configured, but the \"Unsafe Custom SQL\" submodule (search_api_sql_aggregator_unsafe) is not installed — these blocks cannot run at all until it is installed"
msgstr "@n блок(ов) Unsafe Custom SQL настроено, но субмодуль «Unsafe Custom SQL» (search_api_sql_aggregator_unsafe) не установлен — эти блоки вообще не смогут выполняться, пока он не будет установлен"

msgid "Search API SQL Aggregator — creation key left in settings.php"
msgstr "Search API SQL Aggregator — ключ создания оставлен в settings.php"

msgid "Custom SQL (search_api_sql_aggregator_custom_sql_create_key)"
msgstr "Custom SQL (search_api_sql_aggregator_custom_sql_create_key)"

msgid "Unsafe Custom SQL (search_api_sql_aggregator_unsafe_custom_sql_create_key)"
msgstr "Unsafe Custom SQL (search_api_sql_aggregator_unsafe_custom_sql_create_key)"

msgid "The following creation key(s) are meant to be temporary (present only while authoring a new/changed block) but are still configured: @list. Remove the ones no longer in active use from settings.php — leaving them in place indefinitely defeats their purpose."
msgstr "Следующие ключи создания задуманы как временные (присутствуют только во время создания нового/изменённого блока), но всё ещё настроены: @list. Уберите те, что больше не используются активно, из settings.php — если оставить их бессрочно, это лишает их смысла."

