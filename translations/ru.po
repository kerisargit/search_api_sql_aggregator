# ---------------------------------------------------------------------------

msgid "Enter the time as HH:MM in 24-hour format, from 00:00 to 23:59."
msgstr "Укажите время в формате ЧЧ:ММ (24 часа), от 00:00 до 23:59."

msgid "Interval Trigger is already installed; scheduled aggregation runs through it."
msgstr "Interval Trigger уже установлен; запуски по расписанию идут через него."

msgid "Installed Interval Trigger: scheduled aggregation (cron and page requests) now runs through it."
msgstr "Установлен Interval Trigger: запуски агрегации по расписанию (cron и запросы страниц) теперь идут через него."
msgid "Both time-based triggers — cron and <em>Also trigger on page requests</em> — are handled by the Interval Trigger module and share one schedule. Daily and weekly times use the site time zone; a run missed because nothing triggered Drupal at the scheduled time is caught up on the next cron run or visit."
msgstr "Оба триггера по времени — cron и <em>Также запускать при запросах страниц</em> — обрабатывает модуль Interval Trigger, и расписание у них общее. Ежедневное и еженедельное время считается в часовом поясе сайта; запуск, пропущенный потому, что в назначенное время Drupal никто не дёрнул, выполняется при следующем запуске cron или визите."

msgid "Search API SQL Aggregator — SQLite version"
msgstr "Search API SQL Aggregator — версия SQLite"

msgid "SQLite @min or later is required (UPDATE … FROM)."
msgstr "Нужен SQLite @min или новее (UPDATE … FROM)."

msgid "Search API SQL Aggregator — scheduling"
msgstr "Search API SQL Aggregator — расписание"

msgid "Interval Trigger is not installed: scheduled runs (cron and page requests) are not happening."
msgstr "Interval Trigger не установлен: запуски по расписанию (cron и запросы страниц) не выполняются."

msgid "Run the pending database updates (<code>drush updatedb</code>); they install it."
msgstr "Выполните ожидающие обновления базы (<code>drush updatedb</code>) — они его установят."


msgid "Not started: another aggregation run is still in progress."
msgstr "Не запущено: ещё идёт другой запуск агрегации."

msgid "Operations completed with errors — see the run log below."
msgstr "Операции завершились с ошибками — см. журнал запуска ниже."

msgid "The run failed — see the run log below."
msgstr "Запуск не удался — см. журнал запуска ниже."

msgid "Pick a target first"
msgstr "Сначала выберите цель"

msgid "Incomplete block: it is not included in the configuration until the required zones are filled."
msgstr "Блок не заполнен: он не попадёт в конфигурацию, пока не заполнены обязательные зоны."
